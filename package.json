{
  "name": "streetui",
  "version": "0.1.0",
  "private": true,
  "description": "StreetUI — TypeScript-first semantic application framework with its own renderer",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.4",
    "@vitest/coverage-v8": "2.1.4",
    "tsup": "8.3.5",
    "eslint": "9.13.0",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
