{
  "name": "streetui",
  "version": "1.1.0",
  "private": true,
  "description": "StreetUI — TypeScript-first semantic application framework with its own renderer",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "release:check": "node scripts/release-check.mjs",
    "release:meta": "node scripts/apply-publish-metadata.mjs",
    "release:pack": "node scripts/pack-tarballs.mjs",
    "release:smoke": "node scripts/consumer-smoke.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:publish:dry": "node scripts/publish-packages.mjs --dry-run",
    "release:browser": "node scripts/browser-harness.mjs",
    "readmes": "node scripts/generate-readmes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "@vitest/coverage-v8": "2.1.4",
    "eslint": "9.13.0",
    "playwright": "^1.63.0",
    "tsup": "8.3.5",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
