{
  "name": "streetui",
  "version": "3.3.0",
  "private": true,
  "description": "StreetUI — TypeScript-first semantic application framework with its own renderer",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --reporter=default --reporter=junit --outputFile.junit=ci-artifacts/vitest.xml",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "audit:workflow": "node scripts/ci-workflow-audit.mjs",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "audit:api": "node scripts/api-inventory.mjs",
    "audit:sync": "node scripts/toolchain-sync-audit.mjs",
    "perf:toolchain": "node scripts/toolchain-perf.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages apps examples",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean && rm -rf node_modules",
    "release:check": "node scripts/release-check.mjs",
    "release:meta": "node scripts/apply-publish-metadata.mjs",
    "release:meta:check": "node scripts/apply-publish-metadata.mjs --check",
    "release:build": "node scripts/release-build.mjs",
    "release:pack": "node scripts/pack-tarballs.mjs",
    "release:verify": "node scripts/verify-tarballs.mjs",
    "release:smoke": "node scripts/consumer-smoke.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:publish:dry": "node scripts/publish-packages.mjs --dry-run",
    "release:browser": "node scripts/browser-harness.mjs",
    "check:bundle": "node scripts/bundle-budget.mjs",
    "readmes": "node scripts/generate-readmes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "axe-core": "4.14.0",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "@typescript-eslint/parser": "8.11.0",
    "@vitest/coverage-v8": "2.1.4",
    "eslint": "9.13.0",
    "playwright": "1.63.0",
    "tsup": "8.3.5",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
