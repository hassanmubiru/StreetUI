{
  "name": "@streetui/dsl",
  "version": "0.1.0",
  "description": "StreetUI semantic TypeScript DSL",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streetui/core": "workspace:*",
    "@streetui/graph": "workspace:*",
    "@streetui/state": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*",
    "tsup": "*",
    "vitest": "*"
  }
}
