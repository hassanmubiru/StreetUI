{
  "name": "@streetui/compiler",
  "version": "1.2.0",
  "description": "StreetUI compiler — DSL → validation → Semantic Application Graph",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./diagnostics": {
      "import": {
        "types": "./dist/diagnostics.d.ts",
        "default": "./dist/diagnostics.js"
      },
      "require": {
        "types": "./dist/diagnostics.d.cts",
        "default": "./dist/diagnostics.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streetui/core": "workspace:*",
    "@streetui/graph": "workspace:*",
    "@streetui/dsl": "workspace:*",
    "@streetui/state": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*",
    "tsup": "*",
    "vitest": "*"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
