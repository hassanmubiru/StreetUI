{
  "name": "@streetui/testing",
  "version": "1.6.0",
  "description": "StreetUI testing utilities — test renderer, query helpers, assertions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streetui/core": "workspace:*",
    "@streetui/graph": "workspace:*",
    "@streetui/compiler": "workspace:*",
    "@streetui/dsl": "workspace:*",
    "@streetui/renderer": "workspace:*",
    "@streetui/dom": "workspace:*",
    "@streetui/runtime": "workspace:*",
    "@streetui/scheduler": "workspace:*",
    "@streetui/state": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*",
    "tsup": "*",
    "vitest": "*",
    "happy-dom": "*"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
