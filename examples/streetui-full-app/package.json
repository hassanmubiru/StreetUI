{
  "name": "@streetui/example-full-app",
  "version": "0.8.0",
  "private": true,
  "description": "StreetUI full application — router, resource, SSR, hydration, forms, i18n, context and signals composed into one universal app",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streetui/core": "workspace:*",
    "@streetui/state": "workspace:*",
    "@streetui/dsl": "workspace:*",
    "@streetui/compiler": "workspace:*",
    "@streetui/runtime": "workspace:*",
    "@streetui/renderer": "workspace:*",
    "@streetui/dom": "workspace:*",
    "@streetui/router": "workspace:*",
    "@streetui/forms": "workspace:*",
    "@streetui/i18n": "workspace:*",
    "@streetui/context": "workspace:*"
  },
  "devDependencies": {
    "typescript": "*",
    "tsup": "*",
    "vitest": "*",
    "happy-dom": "*"
  }
}
