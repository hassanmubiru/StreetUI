{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "echo 'no install needed'",
  "framework": null,
  "functions": {
    "api/render.mjs": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/favicon\\.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/browser-entry\\.js$",
      "headers": { "cache-control": "public, max-age=300" },
      "dest": "/dist/browser-entry.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/render.mjs"
    }
  ]
}
