{
  "version": 2,
  "buildCommand": "node ../../node_modules/.bin/tsup",
  "outputDirectory": "dist",
  "installCommand": "echo skip",
  "framework": null,
  "functions": {
    "api/render.mjs": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/favicon\\.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/browser-entry\\.js(\\.map)?$",
      "headers": { "cache-control": "public, max-age=300" },
      "dest": "/browser-entry.js$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/render.mjs"
    }
  ]
}
