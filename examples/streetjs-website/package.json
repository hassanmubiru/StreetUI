{
  "name": "streetjs-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The StreetJS website: docs, guides, API, examples, playground, plugins, changelog and blog in one StreetUI application.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "streetui": "3.0.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "happy-dom": "*",
    "tsup": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.27.7": true
  }
}
