{
  "name": "@streetui/runtime",
  "version": "2.1.0",
  "description": "StreetUI runtime — application mounting, lifecycle, node instances, state/event integration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streetui/core": "2.1.0",
    "@streetui/graph": "2.1.0",
    "@streetui/state": "2.1.0",
    "@streetui/events": "2.1.0",
    "@streetui/scheduler": "2.1.0",
    "@streetui/compiler": "2.1.0",
    "@streetui/dsl": "2.1.0"
  },
  "devDependencies": {
    "typescript": "*",
    "tsup": "*",
    "vitest": "*"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
