# ── Node / package managers ────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log
npm-debug.log*
yarn-error.log

# ── Build outputs ──────────────────────────────────────────────────────────
dist/
dist-tarballs/
*.tgz
*.tar.gz

# ── Turbo ──────────────────────────────────────────────────────────────────
.turbo/

# ── Test / coverage ────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── TypeScript ────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Environment / secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ── Benchmark results & temp ──────────────────────────────────────────────
benchmarks/results/
/tmp/

# ── Root-level milestone / release report markdown ────────────────────────
# README.md and CHANGELOG.md are intentionally NOT listed here — they stay tracked.
# All V*.md report files (any version) are ignored by the glob below.
/V*.md
/CONSOLIDATION-1.0-REPORT.md
/HARDENING_REPORT.md
/VERIFICATION_REPORT.md
